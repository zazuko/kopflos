exports[`@kopflos-labs/pages/lib/SparqlProcessor recognizes exact pageUrl bindings inside OPTIONAL 1`] = `
"PREFIX kopflos: <https://kopflos.described.at/>
PREFIX schema: <http://schema.org/>
CONSTRUCT { ?s schema:url ?page. }
WHERE {
  OPTIONAL {
    BIND(kopflos:pageUrl(?s, schema:about) AS ?__kopflos_pageUrl_0)
    BIND(IRI(?__kopflos_pageUrl_0) AS ?page)
  }
}"
`;

exports[`@kopflos-labs/pages/lib/SparqlProcessor recognizes pageUrl in SELECT subqueries 1`] = `
"PREFIX kopflos: <https://kopflos.described.at/>
PREFIX schema: <http://schema.org/>
CONSTRUCT { ?resource schema:url ?page. }
WHERE {
  {
    SELECT ?resource ?page WHERE {
      ?resource schema:name ?name.
      BIND(kopflos:pageUrl(?resource, schema:mainEntityOfPage) AS ?__kopflos_pageUrl_0)
      BIND(IRI(?__kopflos_pageUrl_0) AS ?page)
    }
  }
}"
`;

