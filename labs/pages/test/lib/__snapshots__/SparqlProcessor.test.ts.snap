exports[`@kopflos-labs/pages/lib/SparqlProcessor keeps extracted bindings inside their own BIND and OPTIONAL scopes 1`] = `
"PREFIX kopflos: <https://kopflos.described.at/>
PREFIX schema: <http://schema.org/>
CONSTRUCT { ?s schema:url ?url. }
WHERE {
  BIND(kopflos:pageUrl(?s, schema:about) AS ?__kopflos_pageUrl_0)
  BIND(CONCAT(STR(IRI(?__kopflos_pageUrl_0)), \\"#details\\") AS ?url)
  OPTIONAL {
    BIND(kopflos:pageUrl(?s, schema:mainEntity) AS ?__kopflos_pageUrl_1)
    BIND(STR(IRI(?__kopflos_pageUrl_1)) AS ?other)
  }
  BIND(\\"unchanged\\" AS ?label)
}"
`;

