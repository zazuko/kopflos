{
  "name": "@zazuko/kopflos",
  "description": "RDF-based web APIs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npm run --ws --if-present prepare; husky",
    "lint": "eslint . --quiet",
    "test": "npm run --ws --if-present test",
    "release": "changeset publish"
  },
  "author": "Zazuko GmbH",
  "license": "MIT",
  "dependencies": {
    "@zazuko/env-node": "^3",
    "husky": "^9.1.6",
    "lint-staged": "^16.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10",
    "@tpluscode/eslint-config": "^3.0.1",
    "@tpluscode/rdf-ns-builders": "^5.1",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/readable-stream": "^4.0.15",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "anylogger-console": "^1.0.0",
    "c8": "^10.1.2",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "mocha": "^12",
    "ts-plugin-sparqlc": "^0.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "packages/*",
    "labs/*",
    "example"
  ],
  "c8": {
    "all": true,
    "reporters": [
      "lcovonly",
      "text-summary"
    ]
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --quiet"
    ]
  },
  "allowScripts": {
    "eslint-plugin-rdf@3.1.0": true
  }
}
